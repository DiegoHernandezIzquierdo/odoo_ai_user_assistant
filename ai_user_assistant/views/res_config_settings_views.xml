<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="res_config_settings_view_form_ai" model="ir.ui.view">
        <field name="name">res.config.settings.view.form.inherit.ai.assistant</field>
        <field name="model">res.config.settings</field>
        <field name="inherit_id" ref="base_setup.res_config_settings_view_form"/>
        <field name="arch" type="xml">
            <xpath expr="//form" position="inside">
                <h2>Asistente de IA (Contextual)</h2>
                <div class="row mt16 o_settings_container" id="ai_assistant_settings">
                    <div class="col-12 col-lg-6 o_setting_box">
                        <div class="o_setting_left_pane"/>
                        <div class="o_setting_right_pane">
                            <label for="ai_assistant_provider"/>
                            <div class="text-muted">
                                Motor de procesamiento de lenguaje natural.
                            </div>
                            <field name="ai_assistant_provider"/>
                        </div>
                    </div>
                    <div class="col-12 col-lg-6 o_setting_box">
                        <div class="o_setting_left_pane"/>
                        <div class="o_setting_right_pane">
                            <label for="ai_assistant_api_key"/>
                            <div class="text-muted">
                                Clave privada de autenticación.
                            </div>
                            <field name="ai_assistant_api_key" password="True"/>
                        </div>
                    </div>
                </div>
            </xpath>
        </field>
    </record>
</odoo>